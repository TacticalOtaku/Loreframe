<div class="loreframe-inspector__body standard-form">
  <fieldset class="loreframe-inspector__section loreframe-inspector__section--general">
    <legend>{{localize "LOREFRAME.UserTemplates.Template"}}</legend>
    <div class="form-group">
      <label for="{{idPrefix}}-name">{{localize "LOREFRAME.UserTemplates.Name"}}</label>
      <div class="form-fields">
        <input type="text" id="{{idPrefix}}-name" name="name" value="{{name}}" maxlength="80" required>
      </div>
    </div>
    <div class="form-group">
      <label for="{{idPrefix}}-description">{{localize "LOREFRAME.UserTemplates.Description"}}</label>
      <div class="form-fields">
        <input type="text" id="{{idPrefix}}-description" name="description" value="{{description}}" maxlength="200">
      </div>
    </div>
    <p class="loreframe-inspector__hint">
      {{localize "LOREFRAME.UserTemplates.BasedOn"}} <strong>{{localize baseName}}</strong>
    </p>
  </fieldset>

  {{> "modules/loreframe/templates/applications/inspector-sections.hbs" idPrefix=idPrefix}}

  <p class="loreframe-inspector__hint">{{localize "LOREFRAME.UserTemplates.Hint"}}</p>
</div>
