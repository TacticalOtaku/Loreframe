<footer class="form-footer loreframe-inspector__footer">
  {{#if canSaveTemplate}}
  <button type="button" class="loreframe-inspector__save-template" data-action="saveAsTemplate">
    <i class="fa-solid fa-bookmark" aria-hidden="true"></i>
    <span>{{localize "LOREFRAME.UserTemplates.SaveAs"}}</span>
  </button>
  {{/if}}
  <button type="button" data-action="close">
    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    <span>{{localize "LOREFRAME.Inspector.Cancel"}}</span>
  </button>
  <button type="submit" {{#if empty}}disabled{{/if}}>
    <i class="fa-solid fa-check" aria-hidden="true"></i>
    <span>{{localize (ifThen submitLabel submitLabel "LOREFRAME.Inspector.Apply")}}</span>
  </button>
</footer>
